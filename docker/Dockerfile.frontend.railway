# ============================================
# Dockerfile para Frontend (Angular) - Railway
# ============================================
# Railway maneja el routing, no necesitamos proxy al backend
# ============================================

# Stage 1: Build
# Usar tag estándar más común
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar archivos de dependencias
COPY package*.json ./
COPY nx.json ./
COPY tsconfig*.json ./

# Instalar dependencias
# Usar npm install con legacy-peer-deps para evitar conflictos
RUN npm install --legacy-peer-deps || npm ci --legacy-peer-deps

# Copiar código fuente
COPY . .

# Build de producción con variables de entorno
# Railway inyecta las variables de entorno, pero Angular necesita que estén disponibles en build time
# El plugin env-var-plugin.js ya maneja variables que empiezan con ENV_
ARG ENV_API_URL
ARG ENV_APP_URL
ARG ENV_SUPABASE_URL
ARG ENV_SUPABASE_ANON_KEY
ARG ENV_AUTH0_DOMAIN
ARG ENV_AUTH0_CLIENT_ID
ARG ENV_AUTH0_AUDIENCE

ENV ENV_API_URL=$ENV_API_URL
ENV ENV_APP_URL=$ENV_APP_URL
ENV ENV_SUPABASE_URL=$ENV_SUPABASE_URL
ENV ENV_SUPABASE_ANON_KEY=$ENV_SUPABASE_ANON_KEY
ENV ENV_AUTH0_DOMAIN=$ENV_AUTH0_DOMAIN
ENV ENV_AUTH0_CLIENT_ID=$ENV_AUTH0_CLIENT_ID
ENV ENV_AUTH0_AUDIENCE=$ENV_AUTH0_AUDIENCE

RUN npm run build -- --configuration=production

# Verificar que el build se completó correctamente
RUN echo "=== Verificando estructura del build ===" && \
    ls -la /app/dist/ || (echo "ERROR: dist/ not found" && exit 1) && \
    ls -la /app/dist/people/ || (echo "ERROR: dist/people/ not found" && exit 1) && \
    echo "=== Contenido de dist/people/ ===" && \
    ls -la /app/dist/people/ && \
    echo "=== Buscando index.html ===" && \
    (find /app/dist/people -name "index.html" -type f || echo "WARNING: index.html not found yet")

# Stage 2: Production
# Usar tag estándar más común
FROM nginx:alpine

# Copiar archivos build
# Angular con SSR genera dist/people/browser, sin SSR genera dist/people directamente
# Copiar ambas posibles ubicaciones y usar la que tenga index.html
COPY --from=builder /app/dist/people /tmp/dist-people

# Mover archivos a la ubicación correcta según la estructura generada
# Agregar timestamp para evitar caché y siempre mostrar logs
RUN echo "=== [$(date)] Verificando estructura copiada ===" && \
    ls -la /tmp/dist-people/ && \
    echo "=== [$(date)] Buscando index.html ===" && \
    find /tmp/dist-people -name "index.html" -type f && \
    if [ -d /tmp/dist-people/browser ] && [ -f /tmp/dist-people/browser/index.html ]; then \
      echo "✅ [$(date)] Using SSR build structure (browser folder)"; \
      cp -r /tmp/dist-people/browser/* /usr/share/nginx/html/; \
      echo "✅ [$(date)] Archivos copiados desde browser/"; \
    elif [ -f /tmp/dist-people/index.html ]; then \
      echo "✅ [$(date)] Using standard build structure"; \
      cp -r /tmp/dist-people/* /usr/share/nginx/html/; \
      echo "✅ [$(date)] Archivos copiados desde dist/people/"; \
    else \
      echo "❌ [$(date)] ERROR: index.html not found in build output!"; \
      echo "=== [$(date)] Contenido completo de /tmp/dist-people/ ==="; \
      ls -laR /tmp/dist-people/; \
      exit 1; \
    fi && \
    echo "=== [$(date)] Limpiando temporal ===" && \
    rm -rf /tmp/dist-people && \
    echo "=== [$(date)] Verificando archivos finales en Nginx ===" && \
    ls -la /usr/share/nginx/html/ | head -20 && \
    echo "=== [$(date)] Total de archivos: $(ls -1 /usr/share/nginx/html/ | wc -l)" && \
    echo "=== [$(date)] Verificando index.html ===" && \
    ls -lh /usr/share/nginx/html/index.html

# Verificar que index.html existe
RUN test -f /usr/share/nginx/html/index.html || (echo "❌ ERROR: index.html not found in final location!" && ls -la /usr/share/nginx/html/ && exit 1) && \
    echo "✅ index.html encontrado correctamente"

# Copiar configuración de nginx (sin proxy al backend, Railway lo maneja)
COPY docker/nginx-frontend-railway.conf /etc/nginx/conf.d/default.conf

# Exponer puerto (Railway asigna dinámicamente a través de variable PORT)
# El script de inicio leerá PORT y configurará Nginx para escuchar en ese puerto
EXPOSE 80

# Healthcheck para Railway
# Usar wget (instalado en nginx:alpine) o curl como fallback
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/health 2>/dev/null || \
      (wget -qO- http://localhost:80/health 2>/dev/null | grep -q healthy) || \
      exit 1

# Crear script de inicio para logging y verificación
# Railway asigna puertos dinámicamente, necesitamos usar la variable PORT
RUN echo '#!/bin/sh' > /docker-entrypoint.sh && \
    echo 'set -e' >> /docker-entrypoint.sh && \
    echo 'echo "=== [$(date)] Iniciando Nginx ==="' >> /docker-entrypoint.sh && \
    echo 'echo "=== [$(date)] Verificando archivos en /usr/share/nginx/html/ ==="' >> /docker-entrypoint.sh && \
    echo 'ls -la /usr/share/nginx/html/ | head -10' >> /docker-entrypoint.sh && \
    echo 'echo "=== [$(date)] Verificando index.html ==="' >> /docker-entrypoint.sh && \
    echo 'test -f /usr/share/nginx/html/index.html && echo "✅ index.html existe" || echo "❌ index.html NO existe"' >> /docker-entrypoint.sh && \
    echo 'echo "=== [$(date)] Configurando puerto para Railway ==="' >> /docker-entrypoint.sh && \
    echo 'PORT=${PORT:-80}' >> /docker-entrypoint.sh && \
    echo 'echo "✅ Railway PORT: $PORT"' >> /docker-entrypoint.sh && \
    echo 'if [ "$PORT" != "80" ]; then' >> /docker-entrypoint.sh && \
    echo '  echo "⚠️  Railway asignó puerto $PORT, actualizando configuración de Nginx..."' >> /docker-entrypoint.sh && \
    echo '  sed -i "s/listen 80;/listen $PORT;/" /etc/nginx/conf.d/default.conf' >> /docker-entrypoint.sh && \
    echo '  echo "✅ Nginx configurado para escuchar en puerto $PORT"' >> /docker-entrypoint.sh && \
    echo 'fi' >> /docker-entrypoint.sh && \
    echo 'echo "=== [$(date)] Verificando configuración de Nginx ==="' >> /docker-entrypoint.sh && \
    echo 'nginx -t' >> /docker-entrypoint.sh && \
    echo 'echo "=== [$(date)] Iniciando Nginx en modo foreground ==="' >> /docker-entrypoint.sh && \
    echo 'exec nginx -g "daemon off;"' >> /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

# Usar ENTRYPOINT para asegurar que Railway no sobrescriba el comando
# Esto previene que Railway ejecute npm start automáticamente
ENTRYPOINT ["/docker-entrypoint.sh"]

