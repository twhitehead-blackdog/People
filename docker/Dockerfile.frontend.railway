# ============================================
# Dockerfile para Frontend (Angular) - Railway
# ============================================
# Railway maneja el routing, no necesitamos proxy al backend
# ============================================

# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar archivos de dependencias
COPY package*.json ./
COPY nx.json ./
COPY tsconfig*.json ./

# Instalar dependencias
# Usar npm install con legacy-peer-deps para evitar conflictos
RUN npm install --legacy-peer-deps || npm ci --legacy-peer-deps

# Copiar código fuente
COPY . .

# Build de producción con variables de entorno
# Railway inyecta las variables de entorno, pero Angular necesita que estén disponibles en build time
# El plugin env-var-plugin.js ya maneja variables que empiezan con ENV_
ARG ENV_API_URL
ARG ENV_APP_URL
ARG ENV_SUPABASE_URL
ARG ENV_SUPABASE_ANON_KEY
ARG ENV_AUTH0_DOMAIN
ARG ENV_AUTH0_CLIENT_ID
ARG ENV_AUTH0_AUDIENCE

ENV ENV_API_URL=$ENV_API_URL
ENV ENV_APP_URL=$ENV_APP_URL
ENV ENV_SUPABASE_URL=$ENV_SUPABASE_URL
ENV ENV_SUPABASE_ANON_KEY=$ENV_SUPABASE_ANON_KEY
ENV ENV_AUTH0_DOMAIN=$ENV_AUTH0_DOMAIN
ENV ENV_AUTH0_CLIENT_ID=$ENV_AUTH0_CLIENT_ID
ENV ENV_AUTH0_AUDIENCE=$ENV_AUTH0_AUDIENCE

RUN npm run build -- --configuration=production

# Stage 2: Production
FROM nginx:alpine

# Copiar archivos build
COPY --from=builder /app/dist/people/browser /usr/share/nginx/html

# Copiar configuración de nginx (sin proxy al backend, Railway lo maneja)
COPY docker/nginx-frontend-railway.conf /etc/nginx/conf.d/default.conf

# Exponer puerto (Railway asigna dinámicamente, pero Nginx escucha en 80)
# Railway redirige el puerto asignado al 80 del contenedor
EXPOSE 80

# Usar ENTRYPOINT para asegurar que Railway no sobrescriba el comando
# Esto previene que Railway ejecute npm start automáticamente
ENTRYPOINT ["nginx", "-g", "daemon off;"]

