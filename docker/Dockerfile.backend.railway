# ============================================
# Dockerfile para Backend (Express) - Railway
# ============================================
# Railway asigna PORT automáticamente, no necesitas especificarlo
# ============================================

FROM node:20-alpine

WORKDIR /app

# Instalar dependencias del sistema
RUN apk add --no-cache python3 make g++

# Copiar archivos de dependencias
COPY package*.json ./

# Instalar dependencias (Railway necesita dev dependencies para tsx)
# Usar npm install con legacy-peer-deps para evitar conflictos
RUN npm install --legacy-peer-deps || npm ci --legacy-peer-deps

# Copiar código fuente
COPY server.ts ./
COPY tsconfig.json ./
COPY plugins/ ./plugins/

# Instalar tsx globalmente
RUN npm install -g tsx

# Exponer puerto (Railway asigna dinámicamente via $PORT)
# No especificamos puerto fijo, Railway lo maneja
EXPOSE 3000

# Healthcheck (usa PORT de environment o 3000 por defecto)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || 3000) + '/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})" || exit 1

# Comando de inicio
# Railway inyecta PORT automáticamente, server.ts debe usarlo
CMD ["tsx", "server.ts"]

